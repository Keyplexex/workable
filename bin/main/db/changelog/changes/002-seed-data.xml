<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="seed-enable-uuid" author="carshow" runOnChange="false" runAlways="false">
        <sql>CREATE EXTENSION IF NOT EXISTS "pgcrypto";</sql>
        <rollback>
        </rollback>
    </changeSet>

    <changeSet id="seed-initial-data" author="carshow">
        
        <insert tableName="users">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
            <column name="removed" valueBoolean="false"/>
            <column name="dtype" value="Manager"/>
            <column name="name" value="Иван Менеджеров"/>
            <column name="email" value="manager@carshow.ru"/>
            <column name="phone" value="+79991234567"/>
        </insert>
        
        <insert tableName="users">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
            <column name="removed" valueBoolean="false"/>
            <column name="dtype" value="Client"/>
            <column name="name" value="Алексей Клиентов"/>
            <column name="email" value="client@example.com"/>
            <column name="phone" value="+79997654321"/>
        </insert>
        
        <insert tableName="car_models">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
            <column name="removed" valueBoolean="false"/>
            <column name="brand" value="BMW"/>
            <column name="name" value="320i"/>
            <column name="base_price" value="3500000.00"/>
            <column name="body_type" value="SEDAN"/>
        </insert>
        
        
        <insert tableName="parts">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
            <column name="removed" valueBoolean="false"/>
            <column name="name" value="Масляный фильтр"/>
            <column name="category" value="ENGINE"/>
            <column name="price" value="1500.00"/>
            <column name="manufacturer" value="Bosch"/>
            <column name="part_number" value="BF-12345"/>
            <column name="quantity" value="50"/>
        </insert>
        
    </changeSet>

</databaseChangeLog>