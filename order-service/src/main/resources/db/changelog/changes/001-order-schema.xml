<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="order-1" author="carshow">
        <sql>CREATE EXTENSION IF NOT EXISTS "pgcrypto";</sql>
    </changeSet>

    <changeSet id="order-2" author="carshow">
        <createTable tableName="users">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="removed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="dtype" type="varchar(50)"><constraints nullable="false"/></column>
            <column name="name" type="varchar(255)"/>
            <column name="email" type="varchar(255)"/>
            <column name="phone" type="varchar(50)"/>
        </createTable>
    </changeSet>

    <changeSet id="order-3" author="carshow">
        <createTable tableName="car_models">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="removed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="brand" type="varchar(100)"/>
            <column name="name" type="varchar(100)"/>
            <column name="base_price" type="decimal(15,2)"/>
            <column name="body_type" type="varchar(50)"/>
        </createTable>
    </changeSet>

    <changeSet id="order-4" author="carshow">
        <createTable tableName="components">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="removed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="name" type="varchar(255)"/>
            <column name="type" type="varchar(100)"/>
            <column name="price_supplement" type="decimal(10,2)"/>
            <column name="is_default" type="boolean" defaultValueBoolean="false"/>
            <column name="car_model_id" type="uuid"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="components" baseColumnNames="car_model_id"
                                 constraintName="fk_order_components_model"
                                 referencedTableName="car_models" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="order-5" author="carshow">
        <createTable tableName="components_compatible_models">
            <column name="component_id" type="uuid"/>
            <column name="car_model_id" type="uuid"/>
        </createTable>
        <addPrimaryKey tableName="components_compatible_models" columnNames="component_id, car_model_id"
                       constraintName="pk_order_ccm"/>
        <addForeignKeyConstraint baseTableName="components_compatible_models" baseColumnNames="component_id"
                                 constraintName="fk_order_ccm_component"
                                 referencedTableName="components" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="components_compatible_models" baseColumnNames="car_model_id"
                                 constraintName="fk_order_ccm_model"
                                 referencedTableName="car_models" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="order-6" author="carshow">
        <createTable tableName="orders">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="removed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="dtype" type="varchar(50)"><constraints nullable="false"/></column>
            <column name="client_id" type="uuid"/>
            <column name="manager_id" type="uuid"/>
            <column name="status" type="varchar(50)"/>
            <column name="car_id" type="uuid"/>
            <column name="car_model_id" type="uuid"/>
            <column name="selected_components" type="jsonb"/>
            <column name="final_price" type="decimal(15,2)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="orders" baseColumnNames="client_id"
                                 constraintName="fk_order_orders_client"
                                 referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="orders" baseColumnNames="manager_id"
                                 constraintName="fk_order_orders_manager"
                                 referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="orders" baseColumnNames="car_model_id"
                                 constraintName="fk_order_orders_model"
                                 referencedTableName="car_models" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="order-7" author="carshow">
        <createTable tableName="test_drive_requests">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="removed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="client_id" type="uuid"/>
            <column name="car_id" type="uuid"/>
            <column name="start_date_time" type="timestamp with time zone"/>
            <column name="status" type="varchar(50)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="test_drive_requests" baseColumnNames="client_id"
                                 constraintName="fk_order_tdr_client"
                                 referencedTableName="users" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="order-8" author="carshow">
        <createTable tableName="outbox_message">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="published_at" type="timestamp with time zone"/>
            <column name="aggregate_type" type="varchar(64)"><constraints nullable="false"/></column>
            <column name="aggregate_id" type="uuid"><constraints nullable="false"/></column>
            <column name="routing_key" type="varchar(128)"><constraints nullable="false"/></column>
            <column name="payload" type="text"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="order-9" author="carshow">
        <createTable tableName="processed_incoming_event">
            <column name="event_id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="processed_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>
</databaseChangeLog>
