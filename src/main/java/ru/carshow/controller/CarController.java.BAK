package ru.carshow.controller;

import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.*;
import ru.carshow.dto.CarResponse;
import ru.carshow.dto.CreateCarRequest;
import ru.carshow.dto.UpdateCarRequest;
import ru.carshow.mapper.CarMapper;
import ru.carshow.service.CarService;
import java.util.List;
import java.util.UUID;
import java.util.stream.Collectors;

@RestController
@RequestMapping("/api/cars")
@RequiredArgsConstructor
@Tag(name = "Автомобили", description = "Управление автомобилями")
public class CarController {
    
    private final CarService carService;
    private final CarMapper carMapper;
    
    @GetMapping
    @Operation(summary = "Получить список доступных автомобилей")
    public List<CarResponse> getAvailableCars() {
        return carService.getAvailableCars().stream()
            .map(carMapper::toResponse)
            .collect(Collectors.toList());
    }
    
    @GetMapping("/{id}")
    @Operation(summary = "Получить автомобиль по ID")
    public CarResponse getCarById(@PathVariable UUID id) {
        return carMapper.toResponse(carService.getCarById(id));
    }
    
    @PostMapping
    @ResponseStatus(HttpStatus.CREATED)
    @Operation(summary = "Создать новый автомобиль")
    public CarResponse createCar(@Valid @RequestBody CreateCarRequest request) {
        return carMapper.toResponse(carService.createCar(request));
    }
    
    @PutMapping("/{id}")
    @Operation(summary = "Обновить автомобиль")
    public CarResponse updateCar(@PathVariable UUID id, @RequestBody UpdateCarRequest request) {
        return carMapper.toResponse(carService.updateCar(id, request));
    }
    
    @DeleteMapping("/{id}")
    @ResponseStatus(HttpStatus.NO_CONTENT)
    @Operation(summary = "Удалить автомобиль (soft delete)")
    public void deleteCar(@PathVariable UUID id) {
        carService.deleteCar(id);
    }
    
    @PostMapping("/{id}/test-drive")
    @Operation(summary = "Добавить автомобиль в список для тест-драйва")
    public void addToTestDrive(@PathVariable UUID id) {
        carService.addCarToTestDrive(id);
    }
    
    @DeleteMapping("/{id}/test-drive")
    @Operation(summary = "Удалить автомобиль из списка для тест-драйва")
    public void removeFromTestDrive(@PathVariable UUID id) {
        carService.removeCarFromTestDrive(id);
    }
}