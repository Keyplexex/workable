<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1" author="carshow">
        <sql>CREATE EXTENSION IF NOT EXISTS "pgcrypto";</sql>
    </changeSet>

    <changeSet id="2" author="carshow">
        <createTable tableName="users">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="removed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="dtype" type="varchar(50)"><constraints nullable="false"/></column>
            <column name="name" type="varchar(255)"/>
            <column name="email" type="varchar(255)"/>
            <column name="phone" type="varchar(50)"/>
        </createTable>
    </changeSet>

    <changeSet id="3" author="carshow">
        <createTable tableName="car_models">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="removed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="brand" type="varchar(100)"/>
            <column name="name" type="varchar(100)"/>
            <column name="base_price" type="decimal(15,2)"/>
            <column name="body_type" type="varchar(50)"/>
        </createTable>
    </changeSet>

    <changeSet id="4" author="carshow">
        <createTable tableName="cars">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="removed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="vin" type="varchar(17)"><constraints nullable="false" unique="true"/></column>
            <column name="year" type="integer"/>
            <column name="color" type="varchar(50)"/>
            <column name="engine_power" type="decimal(10,2)"/>
            <column name="engine_volume" type="decimal(5,2)"/>
            <column name="fuel_type" type="varchar(50)"/>
            <column name="transmission" type="varchar(50)"/>
            <column name="drive_type" type="varchar(50)"/>
            <column name="price" type="decimal(15,2)"/>
            <column name="status" type="varchar(50)"/>
            <column name="model_id" type="uuid"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="cars" baseColumnNames="model_id"
                                constraintName="fk_cars_model"
                                referencedTableName="car_models" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="5" author="carshow">
        <createTable tableName="components">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="removed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="name" type="varchar(255)"/>
            <column name="type" type="varchar(100)"/> 
            <column name="price_supplement" type="decimal(10,2)"/> 
            <column name="is_default" type="boolean" defaultValueBoolean="false"/>
            <column name="car_model_id" type="uuid"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="components" baseColumnNames="car_model_id"
                                constraintName="fk_components_model"
                                referencedTableName="car_models" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="6" author="carshow">
        <createTable tableName="components_compatible_models">
            <column name="component_id" type="uuid"/>
            <column name="car_model_id" type="uuid"/>
        </createTable>
        <addPrimaryKey tableName="components_compatible_models" columnNames="component_id, car_model_id"
                      constraintName="pk_ccm_compatible"/>
        <addForeignKeyConstraint baseTableName="components_compatible_models" baseColumnNames="component_id"
                                constraintName="fk_ccm_component"
                                referencedTableName="components" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="components_compatible_models" baseColumnNames="car_model_id"
                                constraintName="fk_ccm_model"
                                referencedTableName="car_models" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="7" author="carshow">
        <createTable tableName="parts">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="removed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="name" type="varchar(255)"/>
            <column name="category" type="varchar(100)"/>
            <column name="price" type="decimal(10,2)"/>
            <column name="manufacturer" type="varchar(255)"/>
            <column name="part_number" type="varchar(100)"/>
            <column name="quantity" type="integer"/>
        </createTable>
    </changeSet>

    <changeSet id="8" author="carshow">
        <createTable tableName="parts_compatible_models">
            <column name="part_id" type="uuid"/>
            <column name="car_model_id" type="uuid"/>
        </createTable>
        <addPrimaryKey tableName="parts_compatible_models" columnNames="part_id, car_model_id"
                      constraintName="pk_pcm_compatible"/>
        <addForeignKeyConstraint baseTableName="parts_compatible_models" baseColumnNames="part_id"
                                constraintName="fk_pcm_part"
                                referencedTableName="parts" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="parts_compatible_models" baseColumnNames="car_model_id"
                                constraintName="fk_pcm_model"
                                referencedTableName="car_models" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="9" author="carshow">
        <createTable tableName="orders">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="removed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="dtype" type="varchar(50)"><constraints nullable="false"/></column>
            <column name="client_id" type="uuid"/>
            <column name="manager_id" type="uuid"/>
            <column name="status" type="varchar(50)"/>
            <column name="car_id" type="uuid"/>
            <column name="car_model_id" type="uuid"/>
            <column name="selected_components" type="jsonb"/> 
            <column name="final_price" type="decimal(15,2)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="orders" baseColumnNames="client_id"
                                constraintName="fk_orders_client"
                                referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="orders" baseColumnNames="manager_id"
                                constraintName="fk_orders_manager"
                                referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="orders" baseColumnNames="car_id"
                                constraintName="fk_orders_car"
                                referencedTableName="cars" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="orders" baseColumnNames="car_model_id"
                                constraintName="fk_orders_model"
                                referencedTableName="car_models" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="10" author="carshow">
        <createTable tableName="test_drive_requests">
            <column name="id" type="uuid"><constraints primaryKey="true"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"/>
            <column name="removed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="client_id" type="uuid"/>
            <column name="car_id" type="uuid"/>
            <column name="start_date_time" type="timestamp with time zone"/>
            <column name="status" type="varchar(50)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="test_drive_requests" baseColumnNames="client_id"
                                constraintName="fk_tdr_client"
                                referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="test_drive_requests" baseColumnNames="car_id"
                                constraintName="fk_tdr_car"
                                referencedTableName="cars" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>